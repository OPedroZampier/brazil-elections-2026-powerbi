	measure Dim_UF =
			
			DISTINCT(
			    UNION(
			        SELECTCOLUMNS(
			            Dim_Municipio,
			            "SG_UF", Dim_Municipio[SG_UF]
			        ),
			        SELECTCOLUMNS(
			            vagas,
			            "SG_UF", vagas[SG_UF]
			        ),
			        SELECTCOLUMNS(
			            eleitorado_cruzado,
			            "SG_UF", eleitorado_cruzado[SG_UF]
			        )
			    )
			)
		lineageTag: b8133175-6c2f-4060-ad00-205244e88901

