	measure 'Ranking Financeiro Pessoas' =
			
			UNION(
			    SELECTCOLUMNS(
			        receitas_candidatos,
			        "Nome", receitas_candidatos[NM_DOADOR],
			        "Tipo", "Doador",
			        "Valor", receitas_candidatos[VR_RECEITA]
			    ),
			    SELECTCOLUMNS(
			        despesas_contratadas,
			        "Nome", despesas_contratadas[NM_FORNECEDOR],
			        "Tipo", "Fornecedor",
			        "Valor", despesas_contratadas[VR_DESPESA_CONTRATADA]
			    )
			)
