	measure 'Idade Média na Posse' =
			
			CALCULATE(
			    AVERAGE(Candidatos_Complementar[NR_IDADE_DATA_POSSE]),
			    Candidatos_Complementar[NR_IDADE_DATA_POSSE] >= 18,
			    Candidatos_Complementar[NR_IDADE_DATA_POSSE] <= 100
			)
		lineageTag: f9717d0d-f86d-4f5f-ada2-2c81c19faa79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Percentual de Reeleição' =
			
			VAR CandidatosReeleicao =
			    CALCULATE(
			        DISTINCTCOUNT(Candidatos_Complementar[CH_CANDIDATO]),
			        Candidatos_Complementar[ST_REELEICAO] = "S"
			    )
			VAR CandidatosInformados =
			    CALCULATE(
			        DISTINCTCOUNT(Candidatos_Complementar[CH_CANDIDATO]),
			        Candidatos_Complementar[ST_REELEICAO] IN { "S", "N" }
			    )
			RETURN
			    DIVIDE(
			        CandidatosReeleicao,
			        CandidatosInformados,
			        0
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cc3eb116-521b-4b0e-9733-9a21325b6dff

	measure 'Candidaturas Quilombolas' =
			
			CALCULATE(
			    DISTINCTCOUNT(Candidatos_Complementar[CH_CANDIDATO]),
			    Candidatos_Complementar[ST_QUILOMBOLA] = "S"
			)
		formatString: 0
		lineageTag: 45bdfdb7-3a04-48b3-a290-1831d94902b6

	measure 'Percentual com Presença Digital' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(redes_sociais[CH_CANDIDATO]),
			        redes_sociais[DS_URL] <> BLANK(),
			        redes_sociais[DS_URL] <> ""
			    ),
			    [Total Candidaturas],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4e205540-ccee-4a7c-bb5f-a2c6d1177806

	measure 'Candidaturas por Idade' =
			
			DISTINCTCOUNT(Candidatos_Complementar[CH_CANDIDATO])
		formatString: 0
		lineageTag: 10f549a4-a0cd-492d-916e-05180912b4b5

	measure 'Ranking Ocupação' =
			
			VAR OcupacaoAtual =
			    SELECTEDVALUE(Candidatos[DS_OCUPACAO])
			RETURN
			IF(
			    ISBLANK(OcupacaoAtual)
			        || OcupacaoAtual IN {
			            "OUTROS",
			            "NÃO INFORMADO",
			            "#NE",
			            "#NULO"
			        },
			    BLANK(),
			    RANKX(
			        FILTER(
			            ALLSELECTED(Candidatos[DS_OCUPACAO]),
			            NOT (
			                Candidatos[DS_OCUPACAO] IN {
			                    "OUTROS",
			                    "NÃO INFORMADO",
			                    "#NE",
			                    "#NULO"
			                }
			            )
			        ),
			        [Total Candidaturas],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		lineageTag: ba475f97-17b7-4019-88fe-f124fc7cadc5

	measure 'Idade na Posse - Consulta' =
			
			VAR Idade =
			    MAX(Candidatos_Complementar[NR_IDADE_DATA_POSSE])
			RETURN
			IF(
			    Idade >= 18 && Idade <= 100,
			    Idade,
			    BLANK()
			)
		formatString: 0
		lineageTag: 00bc1ce8-d2b8-4171-8626-7cf6de95d47b

