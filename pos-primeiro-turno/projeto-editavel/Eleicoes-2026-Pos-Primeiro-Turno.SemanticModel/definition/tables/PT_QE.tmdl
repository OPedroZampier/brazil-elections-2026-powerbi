				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"uf", type text}, {"codigo_cargo", Int64.Type}, {"cargo", type text}, {"quociente_eleitoral", Int64.Type}, {"vagas", Int64.Type}, {"data_geracao", type text}, {"hora_geracao", type text}}, "en-US"),
				    Final = Tipos
				in
				    Final

