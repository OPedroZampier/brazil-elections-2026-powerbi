	partition PT_QE = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("D:\eleicoes-2026-powerbi\pos-primeiro-turno\dados\quociente_eleitoral_por_uf.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
