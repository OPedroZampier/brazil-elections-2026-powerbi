table PT_Cadastro
	lineageTag: 710bb03c-c331-40cc-b8fd-c088ff7a7840

	measure 'Eleitos por QP' = CALCULATE(DISTINCTCOUNT(PT_Cadastro[sq_candidato]), PT_Cadastro[resultado] = "ELEITO POR QP")
		formatString: #,0
		lineageTag: 5ee010ba-8ca8-4bf2-936f-788b4e08ccd6

	measure 'Eleitos por média' = CALCULATE(DISTINCTCOUNT(PT_Cadastro[sq_candidato]), PT_Cadastro[resultado] = "ELEITO POR MÉDIA")
		formatString: #,0
		lineageTag: 442326a9-70b0-4ef4-bf23-6260ee8f8887

	measure 'Eleitos proporcionais' = [Eleitos por QP] + [Eleitos por média]
		formatString: #,0
		lineageTag: bea25d86-d5e7-4280-ad60-64016b2981e0

	measure '% Proporcionais por QP' = DIVIDE([Eleitos por QP], [Eleitos proporcionais])
		formatString: 0.00%
		lineageTag: d5233f03-ee6c-43a0-b331-f65941d35aa2

	measure 'Candidatos no segundo turno' = CALCULATE(DISTINCTCOUNT(PT_Cadastro[sq_candidato]), PT_Cadastro[segundo_turno] = 1)
		formatString: #,0
		lineageTag: 9453cc4b-bb83-421d-b69c-002152011b6d

	measure 'Consta na consulta' = IF(SELECTEDVALUE(PT_Cadastro[eleito]) = 1 || SELECTEDVALUE(PT_Cadastro[segundo_turno]) = 1, 1, BLANK())
		formatString: #,0
		lineageTag: 142766fa-aca7-4fe8-818c-93cef4856ec4

	measure 'Eleitos por QP (cartão)' = FORMAT([Eleitos por QP], "#,0", "pt-BR")
		lineageTag: e802f288-5bfc-473b-bebf-e84d73e947fb

	measure 'Candidatos no segundo turno (cartão)' = FORMAT([Candidatos no segundo turno], "#,0", "pt-BR")
		lineageTag: 3878fd8d-c5f9-4c48-afe1-113e7c57000b

	measure 'Eleitos por média (cartão)' = FORMAT([Eleitos por média], "#,0", "pt-BR")
		lineageTag: 92403dd7-809d-4c0e-b443-e9fef32de7ca

	measure '% Proporcionais por QP (cartão)' = FORMAT([% Proporcionais por QP], "0.00%", "pt-BR")
		lineageTag: e17cee5f-da23-4a4e-a6ad-61cee9870e99

