	partition PT_Cadastro = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("D:\eleicoes-2026-powerbi\pos-primeiro-turno\dados\candidaturas_perfil_resultado.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"sq_candidato", type text}, {"turno", Int64.Type}, {"uf", type text}, {"codigo_cargo", Int64.Type}, {"cargo", type text}, {"nome_urna", type text}, {"partido", type text}, {"genero", type text}, {"raca_cor", type text}, {"escolaridade", type text}, {"resultado", type text}, {"eleito", Int64.Type}, {"segundo_turno", Int64.Type}, {"data_geracao", type text}, {"hora_geracao", type text}}, "en-US"),
				    Final = Tipos
				in
				    Final

