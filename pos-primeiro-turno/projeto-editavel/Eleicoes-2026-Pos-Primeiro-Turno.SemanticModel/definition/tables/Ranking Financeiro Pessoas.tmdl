	partition 'Ranking Financeiro Pessoas' = calculated
		mode: import
		source =
				
				UNION(
				    SELECTCOLUMNS(
				        receitas_candidatos,
				        "Nome", receitas_candidatos[NM_DOADOR],
				        "Tipo", "Doador",
				        "Valor", receitas_candidatos[VR_RECEITA]
				    ),
				    SELECTCOLUMNS(
				        despesas_contratadas,
				        "Nome", despesas_contratadas[NM_FORNECEDOR],
				        "Tipo", "Fornecedor",
				        "Valor", despesas_contratadas[VR_DESPESA_CONTRATADA]
				    )
				)

	annotation PBI_Id = 78e787f48ca041d88c8f027bfc5ad845

