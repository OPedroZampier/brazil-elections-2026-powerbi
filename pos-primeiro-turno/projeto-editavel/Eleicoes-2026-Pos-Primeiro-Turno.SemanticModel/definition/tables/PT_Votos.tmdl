		sourceColumn: percentual_oficial

	partition PT_Votos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("D:\eleicoes-2026-powerbi\pos-primeiro-turno\dados\votos_candidatos.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"chave_resultado", type text}, {"eleicao", Int64.Type}, {"turno", Int64.Type}, {"abrangencia", type text}, {"uf", type text}, {"codigo_cargo", Int64.Type}, {"cargo", type text}, {"sq_candidato", type text}, {"numero_candidato", type text}, {"nome", type text}, {"nome_urna", type text}, {"partido", type text}, {"resultado", type text}, {"destino_votos", type text}, {"votos", Int64.Type}, {"percentual_oficial", type number}}, "en-US"),
				    Final = Table.SelectRows(Tipos, each [uf] <> "BR")
				in
				    Final

