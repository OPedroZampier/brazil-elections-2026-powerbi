table PT_Votos
	lineageTag: 32d9ae2c-9190-4892-acdd-fa5f76fa0a10

	measure 'Votos candidato' = IF(HASONEVALUE(PT_Cargo[cargo]), SUM(PT_Votos[votos]), BLANK())
		formatString: #,0
		lineageTag: 2f45670c-54c3-4414-9066-310c0357b82d

	measure '% Votos no cargo' = DIVIDE([Votos candidato],[Votos válidos])
		formatString: 0.00%
		lineageTag: 6f2a253e-63c2-473f-8f5d-042c450e613b

	measure 'Top 10 nome_urna' = IF(RANKX(ALLSELECTED(PT_Votos[nome_urna]), [Votos candidato],, DESC, DENSE) <= 10, [Votos candidato], BLANK())
		formatString: #,0
		lineageTag: d871df7d-9b3f-4d0f-9163-4e1faf314de3

	column chave_resultado
		dataType: string
		lineageTag: 32c62c4a-095b-4078-bb8e-deeb44bb668f
		summarizeBy: none
		sourceColumn: chave_resultado

	column eleicao
		dataType: int64
		lineageTag: 9c74b5e6-6cfc-462f-ab7f-e49488897c15
		summarizeBy: none
		sourceColumn: eleicao

	column turno
