	partition PT_Controle = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("D:\eleicoes-2026-powerbi\pos-primeiro-turno\dados\resultados_abrangencia.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"chave_resultado", type text}, {"eleicao", Int64.Type}, {"turno", Int64.Type}, {"abrangencia", type text}, {"uf", type text}, {"codigo_cargo", Int64.Type}, {"cargo", type text}, {"data_geracao", type text}, {"hora_geracao", type text}, {"data_totalizacao", type text}, {"hora_totalizacao", type text}, {"totalizacao_finalizada", type text}, {"secoes_total", Int64.Type}, {"secoes_totalizadas", Int64.Type}, {"eleitorado", Int64.Type}, {"eleitores_secoes_apuradas", Int64.Type}, {"comparecimento", Int64.Type}, {"abstencoes", Int64.Type}, {"votos_total", Int64.Type}, {"votos_validos", Int64.Type}, {"votos_nominais", Int64.Type}, {"votos_legenda", Int64.Type}, {"votos_brancos", Int64.Type}, {"votos_nulos_total", Int64.Type}, {"votos_nulos", Int64.Type}, {"votos_nulos_tecnicos", Int64.Type}, {"votos_anulados", Int64.Type}, {"votos_anulados_sub_judice", Int64.Type}}, "en-US"),
				    Final = Table.SelectRows(Tipos, each [uf] <> "BR")
				in
				    Final

