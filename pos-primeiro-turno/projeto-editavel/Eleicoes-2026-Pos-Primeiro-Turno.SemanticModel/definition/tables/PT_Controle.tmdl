table PT_Controle
	lineageTag: 2c3c2253-12ce-4353-add5-b0d738848875

	measure 'Votos válidos' = IF(HASONEVALUE(PT_Cargo[cargo]), SUM(PT_Controle[votos_validos]), BLANK())
		formatString: #,0
		lineageTag: 07be6aae-6dc0-427c-950d-65189bada018

	measure 'Votos nominais' = IF(HASONEVALUE(PT_Cargo[cargo]), SUM(PT_Controle[votos_nominais]), BLANK())
		formatString: #,0
		lineageTag: 6a8ae7a9-8df6-409b-b5db-b0bab2a17984

	measure 'Votos de legenda' = IF(HASONEVALUE(PT_Cargo[cargo]), SUM(PT_Controle[votos_legenda]), BLANK())
		formatString: #,0
		lineageTag: 96f2776a-7f61-48ed-b21c-19ef2e2d5d23

	measure '% Seções totalizadas' = IF(HASONEVALUE(PT_Cargo[cargo]), DIVIDE(SUM(PT_Controle[secoes_totalizadas]),SUM(PT_Controle[secoes_total])), BLANK())
		formatString: 0.00%
		lineageTag: 88cf0b21-ac87-4389-805b-d7b1e9538489

	measure 'Comparecimento total' = CALCULATE(SUM(PT_Controle[comparecimento]), PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: 85b2d2a7-27e2-4038-8a69-f234b2fe0f22

	measure Abstenções = CALCULATE(SUM(PT_Controle[abstencoes]), PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: c79c8915-2e89-4d9f-b534-af544a244973

	measure '% Abstenção' = DIVIDE([Abstenções],[Comparecimento total]+[Abstenções])
		formatString: 0.00%
		lineageTag: fa8ee432-5b25-46c3-aeb8-2ae6872ef037

	measure Válidos = CALCULATE(SUM(PT_Controle[votos_validos]), PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: 2e99b7c9-db46-4d18-82e3-1a8decd10cce

	measure Brancos = CALCULATE(SUM(PT_Controle[votos_brancos]), PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: 990f1719-6098-4f5d-9461-d866d5524c07

	measure Nulos = CALCULATE(SUM(PT_Controle[votos_nulos_total]), PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: fd2063d7-1bb8-4085-a23d-085f26f7cc70

	measure Anulados = CALCULATE(SUM(PT_Controle[votos_anulados])+SUM(PT_Controle[votos_anulados_sub_judice]),PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: db3454c9-39ce-45c0-96cc-33533ddc47c2

	measure 'Total de votos presidencial' = CALCULATE(SUM(PT_Controle[votos_total]),PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: 78c79c0b-98ab-4da8-a6a1-79ac2b80de38

	measure '% Brancos' = DIVIDE([Brancos],[Total de votos presidencial])
		formatString: 0.00%
		lineageTag: 726cd2b6-9ae5-42a0-8b3a-d0e2e529c114

	measure '% Nulos' = DIVIDE([Nulos],[Total de votos presidencial])
		formatString: 0.00%
		lineageTag: 2a6a5386-374d-4115-af44-c9dcec11984a

	measure 'Eleitores apurados' = CALCULATE(SUM(PT_Controle[eleitores_secoes_apuradas]),PT_Controle[codigo_cargo]=1)
		formatString: #,0
		lineageTag: 4247134e-e489-4cae-877f-6205702b6c04

	measure '% Seções totalizadas (cartão)' = FORMAT([% Seções totalizadas], "0.00%", "pt-BR")
		lineageTag: 59b029cc-ea90-4b3d-b130-8070f2ec83fb

	measure 'Votos válidos (cartão)' = FORMAT([Votos válidos], "#,0", "pt-BR")
		lineageTag: e1ccbd89-5f8f-46ee-b81a-3515f2f90681

	measure 'Votos de legenda (cartão)' = FORMAT([Votos de legenda], "#,0", "pt-BR")
		lineageTag: f8e83cf0-aef2-4a28-95e7-9f451883f33d

	measure 'Votos nominais (cartão)' = FORMAT([Votos nominais], "#,0", "pt-BR")
		lineageTag: c5445927-a2a4-4b0a-90ac-fb8317094b0a

	measure '% Brancos (cartão)' = FORMAT([% Brancos], "0.00%", "pt-BR")
		lineageTag: 3eb743e6-9923-44e3-967a-49254e5b8f32

	measure 'Comparecimento total (cartão)' = FORMAT([Comparecimento total], "#,0", "pt-BR")
		lineageTag: 3b87fec2-eb6b-40de-8d2e-febf35625448

	measure '% Nulos (cartão)' = FORMAT([% Nulos], "0.00%", "pt-BR")
