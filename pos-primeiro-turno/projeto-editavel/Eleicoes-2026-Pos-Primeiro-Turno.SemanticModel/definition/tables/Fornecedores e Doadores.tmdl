		source = FILTER(UNION(SELECTCOLUMNS(receitas_candidatos, "Nome", receitas_candidatos[NM_DOADOR], "Tipo", "Doador", "Valor", receitas_candidatos[VR_RECEITA], "CH_CANDIDATO", receitas_candidatos[CH_CANDIDATO]), SELECTCOLUMNS(despesas_contratadas, "Nome", despesas_contratadas[NM_FORNECEDOR], "Tipo", "Fornecedor", "Valor", despesas_contratadas[VR_DESPESA_CONTRATADA], "CH_CANDIDATO", despesas_contratadas[CH_CANDIDATO])), NOT ISBLANK([Nome]) && [Valor] > 0)

	annotation PBI_Id = 36a5fd6960fb425e9c5172f3388b8fe7

